# Пример файла подписи. Скопируйте в keystore.properties и подставьте свои значения.
# Файл keystore.properties внесён в .gitignore и не должен попадать в репозиторий.
#
# Example signing config. Copy to keystore.properties and fill in your own values.
# keystore.properties is git-ignored and must never be committed.

# Путь к хранилищу ключей: относительно корня проекта или абсолютный.
# Path to the keystore: relative to the project root, or absolute.
storeFile=trinotify.keystore

# Пароль хранилища / keystore password
storePassword=CHANGE_ME

# Псевдоним ключа / key alias
keyAlias=trinotify

# Пароль ключа / key password
keyPassword=CHANGE_ME
